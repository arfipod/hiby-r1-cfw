#!/bin/sh

# SSH has its own persistent state. Developer Mode remains a master safety gate:
# both switches must be enabled before Dropbear can listen. A deliberately named
# file on the microSD can override both gates for recovery. The monitor also
# follows Wi-Fi address changes so Dropbear never listens on USB or loopback.

state_dir=${R1_SSH_STATE_DIR:-/usr/data/dropbear}
host_key=$state_dir/dropbear_ed25519_host_key
enabled_file=$state_dir/enabled
disabled_file=$state_dir/disabled
run_dir=${R1_SSH_RUN_DIR:-/run}
server_pid=$run_dir/dropbear-r1.pid
monitor_pid=$run_dir/dropbear-r1-monitor.pid
bound_ip=$run_dir/dropbear-r1.ip
log_file=$state_dir/dropbear.log
developer_disabled=${R1_SSH_DEVELOPER_DISABLED:-/usr/data/disableadb}
sd_root=${R1_SSH_SD_ROOT:-/data/mnt/sd_0}
recovery_enable=$sd_root/CFW_SSH_ENABLE
port=2222

pid_matches() {
    pid=$1
    marker=$2
    [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ] &&
        tr '\000' ' ' < "/proc/$pid/cmdline" | grep -q "$marker"
}

read_pid() {
    file=$1
    if [ -r "$file" ]; then
        sed -n '1p' "$file"
    fi
}

wifi_ipv4() {
    ip -4 address show dev wlan0 2>/dev/null |
        awk '/inet / { split($2, address, "/"); print address[1]; exit }'
}

configured_enabled() {
    [ -e "$enabled_file" ] && return 0
    [ -e "$disabled_file" ] && return 1

    # Images built before the dedicated toggle generated a host key as soon as
    # Developer Mode was enabled. Treat that key as the legacy enabled state so
    # an upgrade does not unexpectedly cut off an active recovery channel.
    [ -s "$host_key" ]
}

migrate_legacy_state() {
    [ ! -e "$enabled_file" ] || return 0
    [ ! -e "$disabled_file" ] || return 0
    [ -s "$host_key" ] || return 0
    mkdir -p "$state_dir"
    touch "$enabled_file"
    chmod 0600 "$enabled_file"
}

set_enabled() {
    mkdir -p "$state_dir"
    chmod 0700 "$state_dir"
    touch "$enabled_file" || return 1
    chmod 0600 "$enabled_file"
    rm -f "$disabled_file"
}

set_disabled() {
    mkdir -p "$state_dir"
    chmod 0700 "$state_dir"
    touch "$disabled_file" || return 1
    chmod 0600 "$disabled_file"
    rm -f "$enabled_file"
}

enable_ssh() {
    set_enabled || return 1
    echo "SSH is enabled; Dropbear will follow the wlan0 IPv4 address"
}

disable_ssh() {
    set_disabled || return 1
    stop_server
    echo "SSH is disabled"
}

recovery_requested() {
    [ -e "$recovery_enable" ]
}

rotate_log() {
    [ -f "$log_file" ] || return
    size=$(wc -c < "$log_file")
    if [ "$size" -gt 262144 ]; then
        tail -c 65536 "$log_file" > "$log_file.tmp"
        mv "$log_file.tmp" "$log_file"
    fi
}

stop_server() {
    pid=$(read_pid "$server_pid")
    if pid_matches "$pid" dropbear; then
        kill "$pid" 2>/dev/null || true
        waited=0
        while pid_matches "$pid" dropbear && [ "$waited" -lt 5 ]; do
            sleep 1
            waited=$((waited + 1))
        done
        if pid_matches "$pid" dropbear; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi
    rm -f "$server_pid" "$bound_ip"
}

prepare_state() {
    mkdir -p "$state_dir"
    chmod 0700 "$state_dir"
    if [ -f "$state_dir/authorized_keys" ]; then
        chmod 0600 "$state_dir/authorized_keys"
    fi
    if [ ! -s "$host_key" ]; then
        /usr/bin/dropbearkey -t ed25519 -f "$host_key" >> "$log_file" 2>&1 || return 1
        chmod 0600 "$host_key"
    fi
}

start_server() {
    address=$1
    prepare_state || return 1
    rotate_log
    echo "$(date): starting Dropbear on $address:$port" >> "$log_file"
    /usr/sbin/dropbear \
        -m -r "$host_key" \
        -p "$address:$port" -P "$server_pid" \
        -T 3 -K 30 -I 900 >> "$log_file" 2>&1
    echo "$address" > "$bound_ip"
}

monitor() {
    echo $$ > "$monitor_pid"
    trap 'stop_server; rm -f "$monitor_pid"; exit 0' INT TERM EXIT
    while :; do
        desired_ip=
        if { configured_enabled && [ ! -e "$developer_disabled" ]; } ||
            recovery_requested; then
            desired_ip=$(wifi_ipv4)
        fi

        running_pid=$(read_pid "$server_pid")
        running_ip=
        [ -r "$bound_ip" ] && running_ip=$(sed -n '1p' "$bound_ip")

        if [ -z "$desired_ip" ]; then
            stop_server
        elif ! pid_matches "$running_pid" dropbear || [ "$running_ip" != "$desired_ip" ]; then
            stop_server
            start_server "$desired_ip" || true
        fi
        sleep 5
    done
}

case "${1:-}" in
    start)
        migrate_legacy_state || true
        pid=$(read_pid "$monitor_pid")
        if pid_matches "$pid" r1-ssh-control; then
            exit 0
        fi
        "$0" monitor >/dev/null 2>&1 &
        ;;
    stop)
        pid=$(read_pid "$monitor_pid")
        if pid_matches "$pid" r1-ssh-control; then
            kill "$pid" 2>/dev/null || true
        else
            stop_server
            rm -f "$monitor_pid"
        fi
        ;;
    enable)
        enable_ssh
        ;;
    disable)
        disable_ssh
        ;;
    toggle)
        if configured_enabled; then
            disable_ssh
        else
            enable_ssh
        fi
        ;;
    is-enabled)
        if configured_enabled; then
            echo "enabled"
            exit 0
        fi
        echo "disabled"
        exit 1
        ;;
    monitor)
        monitor
        ;;
    status)
        if configured_enabled; then
            echo "SSH toggle is enabled"
        else
            echo "SSH toggle is disabled"
        fi
        if recovery_requested; then
            echo "microSD recovery override is active: $recovery_enable"
        fi
        pid=$(read_pid "$server_pid")
        if pid_matches "$pid" dropbear; then
            address=$(sed -n '1p' "$bound_ip" 2>/dev/null)
            echo "Dropbear is running as PID $pid on $address:$port"
            exit 0
        fi
        echo "Dropbear is stopped"
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|enable|disable|toggle|is-enabled|status|monitor}" >&2
        exit 1
        ;;
esac
